# Example environment file for the CAD on-prem Compose stack.
#
# Copy to `.env` (gitignored) before running `docker compose up`:
#
#   cp deploy/compose/.env.example deploy/compose/.env
#
# Every variable below MUST be set before booting the stack. The
# values shown are placeholders — never use them in production.

# ─── Postgres ───────────────────────────────────────────────────────
POSTGRES_DB=cad
POSTGRES_USER=cad
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# ─── MinIO (S3-compatible blob store) ───────────────────────────────
MINIO_ROOT_USER=cadadmin
MINIO_ROOT_PASSWORD=change-me-minio-at-least-12-chars
MINIO_BUCKET=cad-artifacts
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Server ──────────────────────────────────────────────────────────
SERVER_PORT=18080
WEB_PORT=15173
JWT_SECRET=change-me-min-32-random-bytes-please
COOKIE_SECRET=change-me-cookie-secret-min-32-chars
ADMIN_EMAIL=admin@example.test
ADMIN_INITIAL_PASSWORD=change-me-admin-password
PUBLIC_BASE_URL=http://localhost:15173
SERVER_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173

# ─── OIDC stub (compiled but disabled in Slice 1) ───────────────────
# The OIDC adapter compiles and is unit-tested but never reaches a real
# IdP until Slice 12. Set OIDC_ENABLED=true only when you have all four
# values populated.
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
