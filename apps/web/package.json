{
  "name": "@cad/web",
  "version": "0.0.1",
  "private": true,
  "description": "Web editor for the CAD monorepo — Vite + React + three.js, kernel in a Web Worker.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rimraf dist .vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "@cad/authoring": "workspace:*",
    "@cad/i18n": "workspace:*",
    "@cad/kernel": "workspace:*",
    "@cad/protocol": "workspace:*",
    "@cad/references": "workspace:*",
    "@cad/sdk": "workspace:*",
    "@cad/sketch": "workspace:*",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "^5.101.2",
    "monaco-editor": "^0.55.1",
    "@salusoft89/planegcs": "^1.1.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.14.1",
    "replicad-opencascadejs": "^0.23.0",
    "three": "^0.185.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cad/config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^20.10.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
