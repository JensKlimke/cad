{
  "name": "@cad/tests-e2e",
  "version": "0.0.1",
  "private": true,
  "description": "Playwright golden journeys for the CAD web editor. Slice 1 drives the real compose-backed login → create project → open document → viewport lifecycle.",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "node ./run-playwright.mjs test",
    "test:headed": "node ./run-playwright.mjs test --headed",
    "test:debug": "node ./run-playwright.mjs test --debug",
    "test:report": "node ./run-playwright.mjs show-report",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@cad/config": "workspace:*",
    "@cad/web": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  }
}
