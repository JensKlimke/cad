{
  "name": "@cad/db",
  "version": "0.0.1",
  "private": true,
  "description": "Drizzle ORM schema, repositories, and migration tooling for the CAD on-prem stack.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "drizzle",
    "scripts",
    "drizzle.config.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "migrate": "tsx scripts/migrate.ts",
    "drizzle:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@cad/config": "workspace:*",
    "@cad/tests-containers": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "0.31.10",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
